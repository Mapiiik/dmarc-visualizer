# Copy to .env and adjust. Everything here is read by Docker Compose.

# --- How the server faces the internet ---------------------------------------------------------
# Standalone, Caddy publishes ports 80 and 443 itself:
COMPOSE_FILE=compose.yaml:compose.direct.yaml
# Behind a proxy that routes TLS by SNI and sends the PROXY protocol (e.g. HAProxy send-proxy-v2):
#COMPOSE_FILE=compose.yaml:compose.behind-proxy.yaml
#INGRESS_NETWORK=ingress
#INGRESS_ALIAS=dmarc_example_com
# Required behind a proxy: where the PROXY protocol header is trusted from, the proxy's network (see
# `docker network inspect`). Without a proxy only this machine is trusted.
#PROXY_ALLOW=172.16.0.0/12
# Only on an internal network, with a certificate from Caddy's own CA (see the README):
#COMPOSE_FILE=compose.yaml:compose.internal.yaml

# Local changes that do not belong here go to compose.override.yaml (ignored by git). With COMPOSE_FILE
# set, Compose does not load it on its own, append it: COMPOSE_FILE=...:compose.override.yaml
# On Windows, separate COMPOSE_FILE with ";" and set COMPOSE_PATH_SEPARATOR=";".
#COMPOSE_PROJECT_NAME=dmarc

# --- Public name and access ---------------------------------------------------------------------
# The hostname the certificate is issued for. DNS must point at this server or at the proxy.
# Internal, a name in the internal DNS or the server's IP address is enough.
SERVER_NAME=dmarc.example.com

# The e-mail of the Let's Encrypt account. The internal mode does not use it, but it must be set.
ACME_EMAIL=admin@example.com

# Who may open Grafana: admins-only (only from ADMIN_IPS, 403 for everyone else) or public. Grafana
# asks for a login either way.
#ACCESS=admins-only
# Addresses or CIDR ranges of administrators, separated by spaces.
ADMIN_IPS="192.0.2.10 198.51.100.0/24"

# --- Grafana ------------------------------------------------------------------------------------
# The administrator, created on the first start only, so make the password a throwaway one. Log in,
# change it, then remove it from here and run `docker compose up -d`: the container keeps it in its
# environment until it is recreated.
# Compose reads "$" in this file as a variable: write a value with "$" in single quotes.
#GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# A new login after this long without activity, and after GRAFANA_MAX_LOGIN at most (5m, 8h, 7d…).
#GRAFANA_IDLE_TIMEOUT=15m
#GRAFANA_MAX_LOGIN=12h

# --- Login through Authentik (OpenID Connect) ---------------------------------------------------
# In Authentik: an OAuth2/OpenID provider (confidential, redirect URI
# https://<SERVER_NAME>/login/generic_oauth) and an application for it. Who may log in is decided by
# the groups: members of OIDC_ADMIN_GROUP become Admin, of OIDC_VIEWER_GROUP Viewer, everyone else is
# refused. The local administrator keeps working.
#OIDC_ENABLED=true
#OIDC_PROVIDER_URL=https://login.example.com
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_ADMIN_GROUP="Grafana Admins"
#OIDC_VIEWER_GROUP="Grafana Viewers"
# The name on the login button.
#OIDC_NAME=Authentik
# "login": Authentik asks for the whole login again at every login to Grafana. Without it the application's
# authorization flow in Authentik decides, such as asking for the second factor unless one was used recently.
#OIDC_LOGIN_PROMPT=login
# Straight to Authentik instead of Grafana's login page; the local login is then at /login?disableAutoLogin.
#OIDC_AUTO_LOGIN=true
# Logging out of Grafana logs out of Authentik as well, through the application's end-session address.
#OIDC_LOGOUT_URL=https://login.example.com/application/o/<application slug>/end-session/

# --- The mailbox the reports arrive in ----------------------------------------------------------
# The address in the rua and ruf tags of the domains' DMARC records. parsedmarc reads REPORTS_FOLDER
# over IMAP with TLS, and moves what it parsed to ARCHIVE_FOLDER/Aggregate, /Failure, /SMTP-TLS or
# /Invalid.
IMAP_HOST=mail.example.com
#IMAP_PORT=993
IMAP_USER=dmarc@example.com
IMAP_PASSWORD=
#REPORTS_FOLDER=INBOX
#ARCHIVE_FOLDER=Archive

# Any other parsedmarc setting goes to parsedmarc.env as PARSEDMARC_{SECTION}_{KEY}=value, for
# example PARSEDMARC_GENERAL_NAMESERVERS=192.0.2.53 (see the parsedmarc documentation).

# --- How long reports are kept ------------------------------------------------------------------
# In days, by the day a report begins (aggregate, SMTP TLS) or the message arrived (failure).
# Checked once a day; 0 keeps them for good. Failure reports carry headers of real messages, with the
# addresses of their senders and recipients: keep them only as long as they are needed.
# The mailbox archive is not touched, empty it in the mailbox.
#RETENTION_AGGREGATE_DAYS=365
#RETENTION_SMTP_TLS_DAYS=365
#RETENTION_FAILURE_DAYS=90

# --- Storage ------------------------------------------------------------------------------------
# The memory OpenSearch takes for itself; the container needs about twice as much.
#OPENSEARCH_HEAP=512m
# Where OpenSearch, Grafana and Caddy keep their data.
#DATA_DIR=./data
